# Copia este archivo a ".env" y completa los valores.

# Bearer Token de X Developer Portal (App -> Keys and tokens -> Bearer Token).
# Usado para búsqueda de posts y consulta de usuarios (requiere créditos de pago
# por uso o un nivel de acceso superior a Free).
X_BEARER_TOKEN=

# --- Login con X (OAuth 2.0 Authorization Code + PKCE) ---
# Usado para conectar tu cuenta y publicar/interactuar como tú mismo.
# App -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un Callback URI registrado en
# App -> User authentication settings -> Callback URI / Redirect URL.
# Local: http://127.0.0.1:5000/callback
# Producción: https://tu-dominio.vercel.app/callback
X_REDIRECT_URI=http://127.0.0.1:5000/callback

# Clave para firmar la sesión de Flask (usada para guardar el login OAuth).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Vista de tendencias (/trends) ---
# Cadena de conexión Postgres (Neon, Supabase, Vercel Postgres, etc.) donde se
# guarda el histórico de corridas de /api/cron/trends. Sin esto, /trends
# muestra un error explicando cómo configurarla.
DATABASE_URL=

# Consulta que rastrea el job diario (mismos operadores que en el buscador:
# lang:, place_country:, from:, hashtags, etc.). Por defecto: posts en
# español que no son retweet.
TRENDS_QUERY=lang:es -is:retweet

# Cuántos posts intenta recolectar cada corrida (paginado, 1000 por defecto).
TRENDS_TARGET_POSTS=1000

# De los posts recolectados, cuántos se analizan con spaCy/NLTK (tópicos,
# bigramas/trigramas, sentimiento, emociones VAD). El análisis es costoso por
# post; se limita para no exceder el tiempo máximo de una función serverless.
TRENDS_ANALYZE_MAX_POSTS=300

# Secreto opcional para proteger /api/cron/trends. Si lo defines aquí y en
# tu proyecto de Vercel, Vercel lo envía automáticamente como
# "Authorization: Bearer <CRON_SECRET>" en sus Cron Jobs; cualquier otra
# petición sin ese header recibe 401.
CRON_SECRET=
