# Copia este archivo a ".env" y completa los valores.

# Bearer Token de X Developer Portal (App -> Keys and tokens -> Bearer Token).
# Usado para búsqueda de posts y consulta de usuarios (requiere créditos de pago
# por uso o un nivel de acceso superior a Free).
X_BEARER_TOKEN=

# --- Login con X (OAuth 2.0 Authorization Code + PKCE) ---
# Usado para conectar tu cuenta y publicar/interactuar como tú mismo.
# App -> Keys and tokens -> OAuth 2.0 Client ID and Client Secret.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un Callback URI registrado en
# App -> User authentication settings -> Callback URI / Redirect URL.
# Local: http://127.0.0.1:5000/callback
# Producción: https://tu-dominio.vercel.app/callback
X_REDIRECT_URI=http://127.0.0.1:5000/callback

# Clave para firmar la sesión de Flask (usada para guardar el login OAuth).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
